{
	"name": "sque",
	"version": "1.0.0",
	"description": "this queue system is for smaller scale only ",
	"main": "index.js",
	"scripts": {
		"start": "electron --trace-warnings .",
		"build": "electron-builder"
	},
	"author": "Cade Lawrenzo Cana",
	"license": "ISC",
	"dependencies": {
		"@ffmpeg/core": "^0.12.10",
		"@ffmpeg/core-mt": "^0.12.10",
		"@ffmpeg/ffmpeg": "^0.12.15",
		"@serialport/parser-readline": "^13.0.0",
		"axios": "^1.12.2",
		"body-parser": "^2.2.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"crc": "^4.3.2",
		"express": "^5.1.0",
		"ini": "^5.0.0",
		"jsonwebtoken": "^9.0.2",
		"mime": "^4.1.0",
		"moment-timezone": "^0.6.0",
		"multer": "^2.0.2",
		"serialport": "^13.0.0",
		"socket.io": "^4.8.1",
		"sqlite3": "^5.1.7",
		"websocket": "^1.0.35"
	},
	"build": {
		"appId": "com.openq.sque",
		"productName": "OpenQ System",
		"directories": {
			"output": "dist_64"
		},
		"win": {
			"target": {
				"target": "nsis",
				"arch": [
					"x64"
				]
			},
			"icon": "./favicon.ico",
			"extraFiles": [
				{
					"from": "./outfolder",
					"to": "./outfolder"
				},
				{
					"from": "./favicon.ico",
					"to": "."
				}
			]
		},
		"nsis": {
			"oneClick": false,
			"perMachine": true,
			"allowToChangeInstallationDirectory": true
		}
	},
	"devDependencies": {
		"electron": "^37.3.0",
		"electron-builder": "^26.0.12"
	}
}
